{
  "PublicOrigin": "https://yapasakay.com",
  "CorsOrigins": [
    "https://yapasakay.com",
    "https://www.yapasakay.com"
  ],
  "ConnectionStrings": {
    "Default": "Data Source=YOUR_SQL_HOST;Initial Catalog=YaPasakay;User ID=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=YaPasakay.Api"
  },
  "Jwt": {
    "Issuer": "YaPasakay",
    "Audience": "YaPasakay",
    "Key": "CHANGE-ME-TO-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARS"
  },
  "Otp": {
    "Mode": "Fixed",
    "AllowDevBypass": false
  }
}
